<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_image"
        android:layout_width="180dp"
        android:layout_height="240dp"
        android:background="@drawable/bg_black_stroke_5dp_corner"
        android:padding="1dp"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginBottom="@dimen/dp_5"
        android:orientation="vertical"
        >

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="标题标题标题标题"
            android:ellipsize="end"
            android:maxLines="2"
            android:maxHeight="@dimen/dp_60"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_20" />

        <RelativeLayout
            android:id="@+id/rl_content"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            >

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@mipmap/icon_wallet_smoney"
                android:gravity="center"
                android:layout_centerVertical="true"
                android:text=" 999"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_18" />

            <TextView
                android:id="@+id/tv_buy"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:background="@drawable/click_btn_black_solid_5dp"
                android:gravity="center"
                android:text="购买"
                android:lines="1"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_18" />

        </RelativeLayout>

    </LinearLayout>




</LinearLayout>